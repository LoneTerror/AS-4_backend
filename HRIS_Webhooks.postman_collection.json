{
  "info": {
    "name": "HRIS Webhooks",
    "_postman_id": "hris-webhooks-collection",
    "description": "Test collection for the HRIS inbound webhook endpoint.\n\nSetup:\n1. Set collection variables: base_url, webhook_secret, auth_token\n2. Get auth_token by hitting POST /v1/auth/login first\n3. Signature is auto-generated by the pre-request script on every request",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8003",
      "type": "string"
    },
    {
      "key": "webhook_secret",
      "value": "localtest123",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "paste_your_jwt_here",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-generate HMAC-SHA256 signature for every request",
          "const secret = pm.collectionVariables.get('webhook_secret');",
          "const body   = pm.request.body.raw;",
          "const sig    = CryptoJS.HmacSHA256(body, secret).toString(CryptoJS.enc.Hex);",
          "pm.request.headers.upsert({",
          "    key:   'X-Webhook-Signature',",
          "    value: 'sha256=' + sig",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Login (get token)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"your_admin_email@example.com\",\n  \"password\": \"your_password\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "http://localhost:8001/v1/auth/login",
          "host": ["http://localhost:8001"],
          "path": ["v1", "auth", "login"]
        },
        "description": "Get a JWT. Copy access_token into the auth_token collection variable."
      },
      "response": []
    },
    {
      "name": "1. employee.created",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{auth_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event_id\": \"test-create-001\",\n  \"event\": \"employee.created\",\n  \"data\": {\n    \"external_id\": \"ext-001\",\n    \"username\": \"arijitb017\",\n    \"email\": \"arijitb017@gmail.com\",\n    \"department_code\": \"ENG\",\n    \"designation_code\": \"SR_DEV\",\n    \"date_of_joining\": \"2024-03-01\",\n    \"date_of_birth\": \"1995-06-15\",\n    \"manager_email\": \"jane.smith@company.com\"\n  }\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/v1/employees/webhooks/hris",
          "host": ["{{base_url}}"],
          "path": ["v1", "employees", "webhooks", "hris"]
        },
        "description": "Creates a new employee row and publishes events:employee.created so Wallet Service auto-creates the wallet.\n\nExpected: 200 { received: true, event: 'employee.created' }\n\nCheck employee service logs for: 'employee created and event published'\nCheck wallet service logs for: 'wallet created for employee'"
      },
      "response": []
    },
    {
      "name": "2. employee.created (replay — idempotency check)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{auth_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event_id\": \"test-create-001\",\n  \"event\": \"employee.created\",\n  \"data\": {\n    \"external_id\": \"ext-001\",\n    \"username\": \"arijitb017\",\n    \"email\": \"arijitb017@gmail.com\",\n    \"department_code\": \"ENG\",\n    \"designation_code\": \"SR_DEV\",\n    \"date_of_joining\": \"2024-03-01\",\n    \"date_of_birth\": \"1995-06-15\",\n    \"manager_email\": \"jane.smith@company.com\"\n  }\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/v1/employees/webhooks/hris",
          "host": ["{{base_url}}"],
          "path": ["v1", "employees", "webhooks", "hris"]
        },
        "description": "Same event_id as request 1 — should be skipped.\n\nExpected: 200 { received: true, event: 'employee.created', skipped: true }\nDB should still have only ONE row for this email."
      },
      "response": []
    },
    {
      "name": "3. employee.updated — department transfer",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{auth_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event_id\": \"test-update-dept-001\",\n  \"event\": \"employee.updated\",\n  \"data\": {\n    \"email\": \"arijitb017@gmail.com\",\n    \"department_code\": \"HR\"\n  }\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/v1/employees/webhooks/hris",
          "host": ["{{base_url}}"],
          "path": ["v1", "employees", "webhooks", "hris"]
        },
        "description": "Transfers employee to HR department.\nOnly department_id changes — designation and manager untouched.\n\nExpected: 200 { received: true, event: 'employee.updated' }"
      },
      "response": []
    },
    {
      "name": "4. employee.updated — promotion",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{auth_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event_id\": \"test-update-promo-001\",\n  \"event\": \"employee.updated\",\n  \"data\": {\n    \"email\": \"arijitb017@gmail.com\",\n    \"designation_code\": \"ENG_MGR\"\n  }\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/v1/employees/webhooks/hris",
          "host": ["{{base_url}}"],
          "path": ["v1", "employees", "webhooks", "hris"]
        },
        "description": "Promotes employee to Engineering Manager.\nOnly designation_id changes.\n\nExpected: 200 { received: true, event: 'employee.updated' }"
      },
      "response": []
    },
    {
      "name": "5. employee.status_changed — deactivate",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{auth_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event_id\": \"test-status-inactive-001\",\n  \"event\": \"employee.status_changed\",\n  \"data\": {\n    \"email\": \"arijitb017@gmail.com\",\n    \"status_code\": \"INACTIVE\"\n  }\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/v1/employees/webhooks/hris",
          "host": ["{{base_url}}"],
          "path": ["v1", "employees", "webhooks", "hris"]
        },
        "description": "Deactivates employee.\nstatus_code must exist in status_master with entity_type = 'GENERAL' (confirmed from seed.py).\n\nExpected: 200 { received: true, event: 'employee.status_changed' }"
      },
      "response": []
    },
    {
      "name": "6. employee.status_changed — reactivate",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{auth_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event_id\": \"test-status-active-001\",\n  \"event\": \"employee.status_changed\",\n  \"data\": {\n    \"email\": \"arijitb017@gmail.com\",\n    \"status_code\": \"ACTIVE\"\n  }\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/v1/employees/webhooks/hris",
          "host": ["{{base_url}}"],
          "path": ["v1", "employees", "webhooks", "hris"]
        },
        "description": "Reactivates employee.\n\nExpected: 200 { received: true, event: 'employee.status_changed' }"
      },
      "response": []
    },
    {
      "name": "7. unknown event — graceful ignore",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{auth_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event_id\": \"test-unknown-001\",\n  \"event\": \"employee.transferred_office\",\n  \"data\": {\n    \"email\": \"arijitb017@gmail.com\",\n    \"office\": \"Mumbai\"\n  }\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/v1/employees/webhooks/hris",
          "host": ["{{base_url}}"],
          "path": ["v1", "employees", "webhooks", "hris"]
        },
        "description": "Unrecognised event type — should not crash.\n\nExpected: 200 { received: true, event: 'employee.transferred_office' }\nCheck logs for: WARNING — unknown event type"
      },
      "response": []
    },
    {
      "name": "8. bad signature — should reject",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{auth_token}}" },
          { "key": "X-Webhook-Signature", "value": "sha256=invalidsignaturehere" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event_id\": \"test-badsig-001\",\n  \"event\": \"employee.created\",\n  \"data\": {\n    \"external_id\": \"ext-999\",\n    \"username\": \"hacker\",\n    \"email\": \"hacker@evil.com\",\n    \"department_code\": \"ENG\",\n    \"designation_code\": \"SR_DEV\",\n    \"date_of_joining\": \"2024-01-01\"\n  }\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/v1/employees/webhooks/hris",
          "host": ["{{base_url}}"],
          "path": ["v1", "employees", "webhooks", "hris"]
        },
        "description": "Sends a hardcoded wrong signature — bypasses the pre-request script.\n\nExpected: 401 { detail: 'Invalid webhook signature.' }\nNo employee should be created."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": ["// intentionally blank — do not override the bad signature header"]
          }
        }
      ],
      "response": []
    }
  ]
}